# Coordinator ruling INV-Q-4542: refuse Spring configuration keys that run SQL or set session state, before any bean
# is created, in every service and in the migration runner.
org.springframework.boot.EnvironmentPostProcessor=\
com.dynokore.platform.serviceruntime.datasource.SqlConfigurationKeyGuard
# Coordinator ruling INV-Q-4694: SpEL is refused where Spring evaluates it; the resolver is installed before any
# bean-defined BeanFactoryPostProcessor.
org.springframework.context.ApplicationContextInitializer=\
com.dynokore.platform.serviceruntime.spel.SpelRefusalInitializer
