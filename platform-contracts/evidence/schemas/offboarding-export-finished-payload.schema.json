{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-contracts.invoice.internal/evidence/schemas/offboarding-export-finished-payload.schema.json",
  "title": "OffboardingExportFinishedPayload",
  "description": "t Conditional presence is stated here, not modelled with oneOf or anyOf. Within a major version this schema is additive-only (API-41): a field is never removed, renamed, retyped or made required.",
  "type": "object",
  "properties": {
    "tenantRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The tenant being offboarded."
    },
    "offboardingRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The offboarding record of the request."
    },
    "exportRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The export of the request."
    },
    "state": {
      "type": "string",
      "enum": [
        "READY",
        "FAILED"
      ],
      "description": "The result of the export."
    },
    "contents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "TRANSMITTED_XML",
          "ACKNOWLEDGEMENTS",
          "DECISION_TRACES",
          "RECONCILIATION_WORK_PAPERS",
          "SOURCE_DOCUMENT_REFERENCES",
          "AUDIT_LOG"
        ]
      },
      "description": "The kinds of content in the export. Present when state is READY."
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the export finished."
    },
    "failureReason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why the export failed. Present when state is FAILED."
    }
  },
  "required": [
    "tenantRef",
    "offboardingRef",
    "exportRef",
    "state",
    "finishedAt"
  ],
  "additionalProperties": true
}
