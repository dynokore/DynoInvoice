{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-contracts.invoice.internal/service-runtime/schemas/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "description": "One error envelope for every error (API-20), application/problem+json (RFC 9457) extended with the catalogue code. Every service's openapi.yaml references this file rather than declaring its own copy.",
  "type": "object",
  "properties": {
    "type": { "type": "string", "format": "uri", "description": "The catalogue code's documentation URI, or about:blank." },
    "title": { "type": "string" },
    "status": { "type": "integer" },
    "detail": { "type": "string" },
    "code": { "type": "string", "description": "The error-catalogue code (model/architecture/error-codes.yaml)." },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/errorItem" }
    },
    "correlationId": { "type": "string" },
    "docUuid": { "type": "string", "format": "uuid" }
  },
  "required": ["type", "title", "status", "code", "correlationId"],
  "additionalProperties": true,
  "$defs": {
    "errorItem": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "field": { "type": "string", "description": "A JSON Pointer (FR-AG.41)." },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
