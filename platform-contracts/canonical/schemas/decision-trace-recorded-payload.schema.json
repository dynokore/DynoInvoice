{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-contracts.invoice.internal/canonical/schemas/decision-trace-recorded-payload.schema.json",
  "title": "DecisionTraceRecordedPayload",
  "description": "Payload of the DecisionTraceRecorded event (catalogued in model/architecture/events.yaml, INV-NOTE-3 \u00a719.8; class: domain). Authored by INV-T-2854 (T10). Within a major version this schema is additive-only (API-41, FR-K.4): a field is never removed, renamed, retyped or made required.",
  "type": "object",
  "properties": {
    "docUuid": {
      "type": "string",
      "format": "uuid",
      "description": "The document's Doc UUID."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "The canonical/payload/submission version number."
    },
    "traceReference": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference to the underlying decision/evidence trace, resolvable by evidence-svc."
    },
    "decisionTrace": {
      "type": "object",
      "description": "The decision trace itself (opaque to this envelope; interpreted by evidence-svc and console-bff, FR-B.6).",
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "description": "Optional. The decisions behind the verdict, one entry per decision, in the shape of DecisionTraceEntry of evidence/openapi.yaml (INV-REQ-942). Readers tolerate its absence.",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z]{3}-[0-9]{3}$"
              },
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "packVersions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "packIdentifier": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "version": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "required": [
                    "packIdentifier",
                    "version"
                  ]
                }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "businessTermId": {
                      "type": "string",
                      "pattern": "^IBT-[0-9]{3}$"
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "code",
              "ruleId",
              "packVersions",
              "inputs"
            ]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "docUuid",
    "version",
    "traceReference",
    "decisionTrace"
  ],
  "additionalProperties": true
}
